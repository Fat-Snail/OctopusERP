{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5001"
  },
  "RateLimit": {
    "PermitLimit": 120,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "crm-route": {
        "ClusterId": "crm",
        "Match": { "Path": "/gw/crm/{**catch}" },
        "Transforms": [ { "PathRemovePrefix": "/gw/crm" } ]
      },
      "wms-route": {
        "ClusterId": "wms",
        "Match": { "Path": "/gw/wms/{**catch}" },
        "Transforms": [ { "PathRemovePrefix": "/gw/wms" } ]
      },
      "mes-route": {
        "ClusterId": "mes",
        "Match": { "Path": "/gw/mes/{**catch}" },
        "Transforms": [ { "PathRemovePrefix": "/gw/mes" } ]
      },
      "fin-route": {
        "ClusterId": "fin",
        "Match": { "Path": "/gw/fin/{**catch}" },
        "Transforms": [ { "PathRemovePrefix": "/gw/fin" } ]
      },
      "self-route": {
        "ClusterId": "self",
        "Match": { "Path": "/gw/self/{**catch}" },
        "Transforms": [ { "PathRemovePrefix": "/gw/self" } ]
      }
    },
    "Clusters": {
      "crm": {
        "Destinations": { "d1": { "Address": "http://localhost:5004/" } }
      },
      "wms": {
        "Destinations": { "d1": { "Address": "http://localhost:5005/" } }
      },
      "mes": {
        "Destinations": { "d1": { "Address": "http://localhost:5006/" } }
      },
      "fin": {
        "Destinations": { "d1": { "Address": "http://localhost:5007/" } }
      },
      "self": {
        "Destinations": { "d1": { "Address": "http://localhost:5100/" } }
      }
    }
  }
}
