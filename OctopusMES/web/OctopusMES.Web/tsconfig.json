{
  // 根配置直接继承 app 配置，使 `npx tsc --noEmit`（CI 的第一步）真正检查 src。
  // 原先是 { "files": [], "references": [...] }，裸 tsc 一个文件都不编译，
  // 永远返回 0 —— CI 的类型检查对本站是空转。
  // vue-tsc -b（npm run build）会按同一份配置检查，行为不变。
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
