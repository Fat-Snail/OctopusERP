#!/usr/bin/env bash
# OctopusERP 推送门禁：push 前运行本地验证（CI 同款检查，quick 层约 10-15 分钟）
# 跳过：git push --no-verify（不推荐——CI 仍会拦截，问题只是延后暴露）
# 手动运行：scripts/verify.sh [quick|full]

ROOT="$(git rev-parse --show-toplevel)"

# pre-push 钩子会从 stdin 收到 refspec，转发给 null 避免脚本误读交互输入
scripts/verify.sh quick </dev/null
RESULT=$?

if [ "$RESULT" -ne 0 ]; then
  echo ""
  echo "❌ [pre-push] 本地验证未通过，推送已拦截。"
  echo "   修复后重试，或确信可跳过时使用：git push --no-verify（CI 仍会把关）"
  exit 1
fi

echo "✅ [pre-push] 本地验证通过，允许推送。"
exit 0
