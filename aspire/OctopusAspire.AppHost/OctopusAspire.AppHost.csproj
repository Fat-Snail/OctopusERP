<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      .NET 11 + Aspire 17：采用路径式项目模型（AddDotnetProject），
      不再用 ProjectReference + IsAspireProjectResource + Projects.* 生成类型。
      项目路径统一在 Program.cs 的 AddDotnetProject(name, path) 中声明。
    -->
    <RootNamespace>OctopusAspire.AppHost</RootNamespace>
    <!--
      必须声明 UserSecretsId：Aspire 用它持久化「自动分配给持久化资源的公网端口」。
      没有它时每次启动 keycloak-db / keycloak 都会拿到新端口，Aspire 因此判定
      「端口变了 → 容器必须重建」，于是每次都冷启动 Keycloak（空卷时还要重新导入 realm）。
      冷启动超过 DCP 的 60s 创建超时会导致 AppHost 直接 SIGABRT 崩溃，
      表现为「整套服务一个都起不来 + 看不到 keycloak 容器」。

      ID 一旦确定就不要再改，否则已持久化的端口会丢失、退回重建行为。
    -->
    <UserSecretsId>octopus-aspire-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire 17.0（2026-11-17 stable；最低 .NET 10，本项目 .NET 11 满足） -->
    <!-- 所有 Aspire 包必须使用相同版本！否则会触发 MissingMethodException
         （13.3 引入了 ExecutableResource 构造函数新参数，旧 JavaScript 包调用会崩） -->
    <!-- Keycloak 扩展至今无 stable：17.0 对应 preview.1.26567.5，与 17.0 主版本对齐 -->
    <PackageReference Include="Aspire.Hosting.AppHost"    Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet"     Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Keycloak"   Version="17.0.0-preview.1.26567.5" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Redis"      Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时依赖：自动匹配当前机器架构（osx-arm64 / osx-x64 / win-x64 等） -->
    <PackageReference Include="Aspire.Hosting.Orchestration.$(NETCoreSdkRuntimeIdentifier)" Version="17.0.0" />
    <PackageReference Include="Aspire.Dashboard.Sdk.$(NETCoreSdkRuntimeIdentifier)" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keycloak realm 自动导入 JSON（输出到 bin，AddKeycloak().WithRealmImport 引用） -->
    <None Update="keycloak\realms\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
