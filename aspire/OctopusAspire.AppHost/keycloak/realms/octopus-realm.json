      "enabled": true,
      "emailVerified": true,
      "email": "admin@octopus.com",
      "firstName": "超级管理员",
      "lastName": "·",
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["offline_access", "uma_authorization"],
      "attributes": {
